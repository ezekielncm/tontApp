# =============================================================================
# TontinesApp — Environment Variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# ── Docker / Deployment ──────────────────────────────────────────────────────
# Docker Hub username or registry prefix (e.g. "ezekielncm")
DOCKER_REGISTRY=ezekielncm
# Image name without registry prefix
DOCKER_IMAGE_NAME=tontapp-api
# Image tag — set automatically by deploy.sh (commit SHA)
IMAGE_TAG=latest

# ── ASP.NET Core ─────────────────────────────────────────────────────────────
# Environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# ── API Port ─────────────────────────────────────────────────────────────────
API_PORT=8080

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=tontinesapp
POSTGRES_USER=tontapp
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_PORT=6379

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_min_32_chars_secure_random_key
JWT_ISSUER=TontinesApp
JWT_AUDIENCE=TontinesApp

# ── Africa's Talking (SMS) ───────────────────────────────────────────────────
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=your_africastalking_username

# ── Mobile Money Integration ─────────────────────────────────────────────────
MOBILEMONEY_API_KEY=your_mobilemoney_api_key
MOBILEMONEY_API_SECRET=your_mobilemoney_api_secret

# ── Orange Money Integration ─────────────────────────────────────────────────
ORANGEMONEY_API_KEY=your_orangemoney_api_key
ORANGEMONEY_API_SECRET=your_orangemoney_api_secret

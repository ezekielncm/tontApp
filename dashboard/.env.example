# Backend API URL (internal Docker network or localhost for dev)
API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# JWT validation (must match ASP.NET API settings)
JWT_SECRET=CHANGE_ME_min_32_chars_secure_random_key
JWT_ISSUER=TontinesApp
JWT_AUDIENCE=TontinesApp

# Dashboard base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Monitoring URLs (for admin dashboard links)
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
